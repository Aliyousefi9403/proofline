# Copy to .env. Never commit .env.

# Anthropic API key for the one LLM call (claim extraction) and the baselines.
# Without it, ProofLine uses the local `claude` CLI if installed, else the
# offline rule-based extractor.
ANTHROPIC_API_KEY=

# auto | anthropic | claude-cli | none
PROOFLINE_LLM=auto
# Model used for extraction and for the naive baseline.
PROOFLINE_MODEL=claude-opus-5-5

# The SEC asks for a name and contact email on automated requests.
SEC_USER_AGENT=Your Name your.email@example.com

# Optional: fixed key for signing certificates (otherwise one is generated locally).
PROOFLINE_SIGNING_KEY=
